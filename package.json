{
	"name": "obsidian-bases-board",
	"version": "1.0.3",
	"description": "Interactive board view for bases, use as Kanban or Gallery, with grouping for rows and columns.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"postversion": "git push origin main && git push origin --tags",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip"
	},
	"lint-staged": {
		"*.{ts,js,mts,mjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,css}": [
			"prettier --write"
		]
	},
	"keywords": [],
	"author": "flowing-abyss",
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "^20.4.3",
		"@commitlint/config-conventional": "^20.4.3",
		"@eslint/js": "^9.30.1",
		"@types/jsdom": "^28.0.1",
		"@types/node": "^20.0.0",
		"@types/sortablejs": "^1.15.9",
		"@vitest/coverage-v8": "^4.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.30.1",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"eslint-plugin-sonarjs": "^4.0.1",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"jiti": "^2.6.1",
		"jsdom": "^29.0.1",
		"knip": "^5.86.0",
		"lint-staged": "^16.3.2",
		"obsidian": "latest",
		"obsidian-test-mocks": "latest",
		"prettier": "^3.8.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"sortablejs": "^1.15.6",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.0.0"
	}
}
